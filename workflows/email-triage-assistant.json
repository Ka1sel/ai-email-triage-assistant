                    "leftValue": "={{ $json.requiresReply === false || $json.category === 'Spam' }}",
                    "rightValue": "",
                    "operator": {
                      "type": "boolean",
                      "operation": "true",
                      "singleValue": true
                    },
                    "id": "96f4374d-fe6e-4d01-9054-312b8dd1404f"
