      ],
      "id": "cea37d5d-32f1-4575-8251-03b22a9609c6",
      "name": "AI Reply Generator",
      "retryOnFail": true,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "jsCode": "\nconst results = [];\n\nfor (const item of $input.all()) {\n  const reply = item.json.text;\n\n  if (typeof reply !== 'string' || !reply.trim()) {\n    throw new Error('AI generated an empty or invalid reply');\n  }\n\n  const original = $('Prepare Reply Context').item.json;\n\n  if (!original.sender || !original.threadId || !original.subject) {\n    throw new Error('Missing original Gmail information');\n  }\n\n  results.push({\n    json: {\n      to: original.sender,\n      subject: original.subject.startsWith('Re:')\n        ? original.subject\n        : `Re: ${original.subject}`,\n      replyBody: reply.trim(),\n      threadId: original.threadId,\n      messageId: original.messageId,\n      category: original.category,\n      urgency: original.urgency\n    }\n  });\n}\n\nreturn results;\n"
      },
